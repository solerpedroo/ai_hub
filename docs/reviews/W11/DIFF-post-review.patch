diff --git a/apps/desktop/src/renderer/src/components/chat/chat-composer.tsx b/apps/desktop/src/renderer/src/components/chat/chat-composer.tsx
--- a/apps/desktop/src/renderer/src/components/chat/chat-composer.tsx
+++ b/apps/desktop/src/renderer/src/components/chat/chat-composer.tsx
@@
+export function matchKnownSlashCommand(draft: string): SlashCommandId | null {
+  const trimmed = draft.trim();
+  if (!trimmed.startsWith("/") || /\s/.test(trimmed)) {
+    return null;
+  }
+  const id = trimmed.slice(1).toLowerCase();
+  return (SLASH_COMMANDS as readonly string[]).includes(id) ? (id as SlashCommandId) : null;
+}
@@
   const submit = (): void => {
     if (busy || disabled || value.trim().length === 0) {
       return;
     }
-    onSend();
+    const command = matchKnownSlashCommand(value);
+    if (command) {
+      onChange("");
+      onSlashCommand(command);
+      return;
+    }
+    onSend();
   };

