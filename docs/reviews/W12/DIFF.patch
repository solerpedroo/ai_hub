+import { mkdirSync, mkdtempSync, writeFileSync } from "node:fs";
+import { createRequire } from "node:module";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { _electron as electron, expect, test, type ElectronApplication } from "@playwright/test";
+
+const require = createRequire(import.meta.url);
+const electronBinary = require("electron") as string;
+const appRoot = path.join(fileURLToPath(new URL("..", import.meta.url)));
+
+function minimalPdf(text: string): Buffer {
+  const stream = `BT /F1 12 Tf 72 720 Td (${text}) Tj ET`;
+  const body = `${stream.length}\nstream\n${stream}\nendstream`;
+  const objects = [
+    "1 0 obj << /Type /Catalog /Pages 2 0 R >> endobj",
+    "2 0 obj << /Type /Pages /Kids [3 0 R] /Count 1 >> endobj",
+    "3 0 obj << /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 5 0 R >> >> >> endobj",
+    `4 0 obj << /Length ${stream.length} >> ${body} endobj`,
+    "5 0 obj << /Type /Font /Subtype /Type1 /BaseFont /Helvetica >> endobj",
+  ];
+  return Buffer.from(`%PDF-1.1\n${objects.join("\n")}\n`, "latin1");
+}
+
+async function launchHub(env: Record<string, string>): Promise<ElectronApplication> {
+  return electron.launch({
+    executablePath: electronBinary,
+    args: [path.join(appRoot, "out/main/index.js")],
+    cwd: appRoot,
+    env: {
+      ...process.env,
+      AI_HUB_E2E: "1",
+      NODE_ENV: "production",
+      ...env,
+    },
+  });
+}
+
+test("attaches a PDF and asks to summarize section 3", async () => {
+  const dir = mkdtempSync(path.join(tmpdir(), "ai-hub-pdf-"));
+  const pdf = path.join(dir, "spec.pdf");
+  writeFileSync(pdf, minimalPdf("Section 3: payments use PostgreSQL"));
+  const app = await launchHub({ AI_HUB_E2E_ATTACH_FILE: pdf });
+  try {
+    const window = await app.firstWindow();
+    const composer = window.getByTestId("chat-composer");
+    await composer.waitFor({ state: "visible", timeout: 30_000 });
+    await window.getByTestId("files-attach").click();
+    await expect(window.getByTestId("files-chip")).toContainText("spec.pdf");
+    await expect(window.getByTestId("files-token-warning")).toBeVisible();
+    await composer.fill("resuma a se├º├úo 3");
+    await composer.press("Enter");
+    await expect(window.getByTestId("message-user")).toContainText("resuma a se├º├úo 3");
+    await expect(window.getByTestId("message-assistant")).toHaveAttribute("data-status", "complete", {
+      timeout: 30_000,
+    });
+  } finally {
+    await app.close();
+  }
+});
+
+test("attaches a Node folder and detects the stack", async () => {
+  const dir = mkdtempSync(path.join(tmpdir(), "ai-hub-node-"));
+  writeFileSync(
+    path.join(dir, "package.json"),
+    JSON.stringify({
+      name: "demo-app",
+      packageManager: "pnpm@10.0.0",
+      dependencies: { react: "19.0.0" },
+    }),
+  );
+  writeFileSync(path.join(dir, "README.md"), "Hello Node workspace");
+  mkdirSync(path.join(dir, "src"));
+  writeFileSync(path.join(dir, "src", "index.ts"), "export {}\n");
+  const app = await launchHub({ AI_HUB_E2E_ATTACH_FOLDER: dir });
+  try {
+    const window = await app.firstWindow();
+    await window.getByTestId("chat-composer").waitFor({ state: "visible", timeout: 30_000 });
+    await window.getByTestId("files-attach-folder").click();
+    await expect(window.getByTestId("files-chip")).toContainText(path.basename(dir));
+    await expect(window.getByTestId("files-chip")).toBeVisible();
+    await window.getByTestId("chat-composer").fill("qual ├® a stack?");
+    await window.getByTestId("chat-composer").press("Enter");
+    await expect(window.getByTestId("message-assistant")).toHaveAttribute("data-status", "complete", {
+      timeout: 30_000,
+    });
+  } finally {
+    await app.close();
+  }
+});
