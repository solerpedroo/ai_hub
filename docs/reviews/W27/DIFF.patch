+describe("parseChecklistItems", () => {
+  it("extracts checkbox and bullet checklist lines", () => {
+    const content = `TASK
+
+Implement JWT
+
+Checklist:
+- [ ] Create User model
+- [x] Create login endpoint
+Ôûí Generate token
+* Middleware
+- Documenta├º├úo
+`;
+    expect(parseChecklistItems(content)).toEqual([
+      "Create User model",
+      "Create login endpoint",
+      "Generate token",
+      "Middleware",
+      "Documenta├º├úo",
+    ]);
+  });
