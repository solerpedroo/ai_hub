+  payload: TIn,
+  inputSchema: ZodType<TIn>,
+): Promise<void> {
+  try {
+    const parsed = inputSchema.parse(payload);
+    const result: unknown = await ipcRenderer.invoke(channel, parsed);
+    ipcAckResultSchema.parse(result);
+  } catch (error) {
+    rethrowIpcError(error);
+  }
 }
 
