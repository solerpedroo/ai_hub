+async function acquireRelayLock(sharedRelay: string): Promise<() => Promise<void>> {
+  const lockPath = join(sharedRelay, "ai-hub-sync-v1.lock");
+  for (let attempt = 0; attempt < RELAY_LOCK_ATTEMPTS; attempt += 1) {
