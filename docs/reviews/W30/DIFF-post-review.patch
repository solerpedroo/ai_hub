+      if (lock && Date.now() - lock.mtimeMs > RELAY_LOCK_STALE_MS) {
+        await unlink(lockPath).catch(() => undefined);
+        continue;
+      }
+      await pause(RELAY_LOCK_RETRY_MS);
+    }
+  }
